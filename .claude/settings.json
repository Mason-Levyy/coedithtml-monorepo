{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-npm-yarn.js",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node .claude/hooks/block-env-reads.js",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-env-reads.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

