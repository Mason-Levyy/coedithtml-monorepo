{
  "name": "coeditHTML",
  "version": "1.0.0",
  "description": "Real-time collaborative editing, sticky redlining, and instant sharing for single-file HTML artifacts generated by AI tools.",
  "protocolVersion": "1.0",
  "url": "https://coedithtml.com",
  "documentationUrl": "https://coedithtml.com/llms.txt",
  "provider": {
    "name": "coeditHTML",
    "url": "https://coedithtml.com"
  },
  "supportedInterfaces": [
    {
      "url": "https://app.coedithtml.com/api",
      "protocolBinding": "HTTP+JSON",
      "protocolVersion": "1.0"
    }
  ],
  "capabilities": {
    "streaming": true,
    "pushNotifications": false
  },
  "skills": [
    {
      "id": "publish_artifact",
      "name": "Publish Artifact",
      "description": "Upload a standalone single-file HTML artifact (up to 5MB) and instantly generate distinct view, suggest, and edit share URLs.",
      "tags": ["html", "publishing", "collaboration", "upload"],
      "inputSchema": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "description": "The raw HTML document content or multipart file upload."
          },
          "password": {
            "type": "string",
            "description": "Optional password to protect access."
          },
          "draft": {
            "type": "boolean",
            "description": "When true, stores file as draft without minting share links."
          }
        },
        "required": ["file"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "artifactId": { "type": "string" },
          "viewUrl": { "type": "string" },
          "suggestUrl": { "type": "string" },
          "editUrl": { "type": "string" },
          "published": { "type": "boolean" }
        },
        "required": ["artifactId", "viewUrl", "suggestUrl", "editUrl", "published"]
      }
    },
    {
      "id": "get_artifact",
      "name": "Get Artifact Metadata",
      "description": "Fetch metadata, capabilities (canWrite, canSuggest), and settings for an artifact using its share token.",
      "tags": ["metadata", "permissions"],
      "inputSchema": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "The unguessable share token for the artifact."
          }
        },
        "required": ["token"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "fileName": { "type": "string" },
          "size": { "type": "number" },
          "uploadedAt": { "type": "string" },
          "tokenKind": { "type": "string", "enum": ["view", "suggest", "edit"] },
          "canWrite": { "type": "boolean" },
          "canSuggest": { "type": "boolean" },
          "hasPassword": { "type": "boolean" },
          "isUnlocked": { "type": "boolean" },
          "viewUrl": { "type": "string" }
        },
        "required": ["fileName", "size", "uploadedAt", "tokenKind", "canWrite", "canSuggest", "hasPassword", "isUnlocked", "viewUrl"]
      }
    },
    {
      "id": "replace_artifact",
      "name": "Replace Artifact Revision",
      "description": "Upload a new revision of the HTML artifact using an edit-capable token.",
      "tags": ["revision", "update"],
      "inputSchema": {
        "type": "object",
        "properties": {
          "token": { "type": "string" },
          "file": { "type": "string" }
        },
        "required": ["token", "file"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "artifactId": { "type": "string" },
          "revision": { "type": "string" },
          "size": { "type": "number" }
        },
        "required": ["artifactId", "revision", "size"]
      }
    },
    {
      "id": "download_artifact",
      "name": "Download Artifact",
      "description": "Download the raw original HTML or the artifact with edited text and embedded feedback stickies.",
      "tags": ["export", "download"]
    },
    {
      "id": "manage_settings",
      "name": "Manage Artifact Settings",
      "description": "Configure or remove passwords and update permissions for an artifact using an edit token.",
      "tags": ["security", "password", "settings"]
    }
  ]
}
