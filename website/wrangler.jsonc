{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coedithtml-website",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "env": {
    "production": {
      "name": "coedithtml-website",
      "routes": [
        {
          "pattern": "coedithtml.com",
          "custom_domain": true
        }
      ]
    }
  }
}
