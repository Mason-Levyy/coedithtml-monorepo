{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    // Generated from wrangler.jsonc by the typecheck script, so binding types
    // can never drift from the deployed config. Not committed — it is 500KB+.
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-pool-workers"],
    "baseUrl": ".",
    "paths": {
      "@/lib/*": ["lib/*"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "lib"]
}
