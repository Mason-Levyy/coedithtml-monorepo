{
  "name": "@coedithtml/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "node assemble-assets.mjs && wrangler deploy --dry-run --outdir dist",
    "deploy": "node assemble-assets.mjs && wrangler deploy --env production",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.7.0",
    "@coedithtml/app": "workspace:*",
    "@coedithtml/runtime": "workspace:*",
    "wrangler": "^4.112.0"
  },
  "dependencies": {
    "@coedithtml/protocol": "workspace:*",
    "zod": "^4.4.3"
  }
}
