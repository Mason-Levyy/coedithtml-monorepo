{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coedit-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": {
    "enabled": true
  },

  "triggers": {
    "crons": ["0 * * * *"]
  },

  "vars": {
    "APP_HOST": "app.localhost:8787",
    "SANDBOX_HOST": "sandbox.localhost:8787",
    "REDIRECT_HOSTS": "www.localhost:8787",
    "REDIRECT_TARGET": "app.localhost:8787",
    "MCP_ENABLED": "true"
  },

  "r2_buckets": [
    {
      "binding": "ARTIFACT_STORE",
      "bucket_name": "coedit-artifacts",
      "preview_bucket_name": "coedit-artifacts-preview"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "ARTIFACT_METADATA",
      "id": "c2a45fd936ac4d798f9c3251e813020f"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "DOC_ROOM",
        "class_name": "DocRoom"
      },
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      },
      {
        "name": "USAGE_LEDGER",
        "class_name": "UsageLedger"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DocRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RateLimiter", "UsageLedger"]
    }
  ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "env": {
    "production": {
      "name": "coedit",
      "vars": {
        "APP_HOST": "app.coedithtml.com",
        "SANDBOX_HOST": "coedit.coedithtml-worker.workers.dev",
        "REDIRECT_HOSTS": "www.coedithtml.com",
        "REDIRECT_TARGET": "coedithtml.com",
        "MCP_ENABLED": "true"
      },

      "triggers": {
        "crons": ["0 * * * *"]
      },

      "workers_dev": true,
      "routes": [
        {
          "pattern": "app.coedithtml.com",
          "custom_domain": true
        },
        {
          "pattern": "www.coedithtml.com",
          "custom_domain": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "ARTIFACT_STORE",
          "bucket_name": "coedit-artifacts"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "ARTIFACT_METADATA",
          "id": "4ec09f8643814541ba2471dad38a887a"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "DOC_ROOM",
            "class_name": "DocRoom"
          },
          {
            "name": "RATE_LIMITER",
            "class_name": "RateLimiter"
          },
          {
            "name": "USAGE_LEDGER",
            "class_name": "UsageLedger"
          }
        ]
      },
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": true
      }
    }
  }
}
