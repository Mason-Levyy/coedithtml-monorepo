{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coedit-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": {
    "enabled": true
  },

  // Two origins, always. The app origin holds the session; the sandbox origin
  // serves untrusted artifact HTML with scripts enabled and must never share
  // an origin with authenticated pages. The Worker refuses to boot if these
  // two match — see hostsAreDistinct in lib/origins.ts.
  //
  // `.localhost` subdomains all resolve to 127.0.0.1, which is what makes two
  // genuinely distinct origins reachable from one local `wrangler dev` port.
  "vars": {
    "APP_HOST": "app.localhost:8787",
    "SANDBOX_HOST": "sandbox.localhost:8787"
  },

  // Artifact bytes, stored and returned unmodified. R2 is the only store here
  // that does not normalize what it is given.
  "r2_buckets": [
    {
      "binding": "ARTIFACT_STORE",
      "bucket_name": "coedit-artifacts",
      "preview_bucket_name": "coedit-artifacts-preview"
    }
  ],

  // Artifact metadata only — never the HTML itself, which would hit KV's 25MB
  // value ceiling and lose byte fidelity.
  //
  // `id` is a placeholder until the namespace is provisioned against a real
  // Cloudflare account. `wrangler dev` simulates KV locally and ignores it;
  // `wrangler deploy` will not.
  "kv_namespaces": [
    {
      "binding": "ARTIFACT_METADATA",
      "id": "placeholder_pending_provisioning"
    }
  ],

  "env": {
    // Named environments inherit nothing: every binding has to be restated
    // here or it is simply absent at runtime and parseWorkerEnv 503s.
    //
    // Routes and DNS still need provisioning against a real Cloudflare
    // account, so these hosts are the intended production pair, not a
    // deployed one. Deploying is blocked until `wrangler login` has been run.
    "production": {
      "vars": {
        "APP_HOST": "coedithtml.com",
        "SANDBOX_HOST": "artifact-sandbox.net"
      },
      "r2_buckets": [
        {
          "binding": "ARTIFACT_STORE",
          "bucket_name": "coedit-artifacts"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "ARTIFACT_METADATA",
          "id": "placeholder_pending_provisioning"
        }
      ]
    }
  }
}
