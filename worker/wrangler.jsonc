{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coedit-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": {
    "enabled": true
  },

  // `.localhost` subdomains all resolve to 127.0.0.1, which is what makes two
  // genuinely distinct origins reachable from one local `wrangler dev` port.
  "vars": {
    "APP_HOST": "app.localhost:8787",
    "SANDBOX_HOST": "sandbox.localhost:8787",
    "REDIRECT_HOSTS": "www.localhost:8787",
    "REDIRECT_TARGET": "app.localhost:8787"
  },

  "r2_buckets": [
    {
      "binding": "ARTIFACT_STORE",
      "bucket_name": "coedit-artifacts",
      "preview_bucket_name": "coedit-artifacts-preview"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "ARTIFACT_METADATA",
      "id": "c2a45fd936ac4d798f9c3251e813020f"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "DOC_ROOM",
        "class_name": "DocRoom"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DocRoom"]
    }
  ],

  // Staged by assemble-assets.mjs: the app build plus the runtime bundle.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "env": {
    "production": {
      "name": "coedit",
      // The apex is deliberately absent: it belongs to the marketing site.
      // The app lives on its own subdomain, and www only exists to bounce
      // visitors to the apex.
      "vars": {
        "APP_HOST": "app.coedithtml.com",
        "SANDBOX_HOST": "coedit.coedithtml-worker.workers.dev",
        "REDIRECT_HOSTS": "www.coedithtml.com",
        "REDIRECT_TARGET": "coedithtml.com"
      },

      // The sandbox origin IS the workers.dev hostname, so this stays on.
      // Defining routes below must not be read as a reason to turn it off.
      "workers_dev": true,
      "routes": [
        {
          "pattern": "app.coedithtml.com",
          "custom_domain": true
        },
        {
          "pattern": "www.coedithtml.com",
          "custom_domain": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "ARTIFACT_STORE",
          "bucket_name": "coedit-artifacts"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "ARTIFACT_METADATA",
          "id": "c2a45fd936ac4d798f9c3251e813020f"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "DOC_ROOM",
            "class_name": "DocRoom"
          }
        ]
      },
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": true
      }
    }
  }
}
