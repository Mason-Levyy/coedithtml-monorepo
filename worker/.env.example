# Copy to .dev.vars for local development. Never commit the real values.
# In production these are Worker secrets: wrangler secret put <NAME> --env production

# Signs the workspace key the MCP tools hand back, so a caller can be recognised
# across calls without an account. Any random string of 32 characters or more;
# rotating it detaches every existing workspace from its quota.
MCP_SIGNING_SECRET=replace-me-with-at-least-thirty-two-characters
